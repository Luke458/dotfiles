[Unit]
Description=Jellyfin media server
PartOf=media-stack.target

[Container]
Image=lscr.io/linuxserver/jellyfin:latest
ContainerName=jellyfin
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=UMASK=002
Environment=TZ=Etc/UTC
AddDevice=/dev/dri:/dev/dri:rwm
GroupAdd=keep-groups
Volume=/home/luke/media-stack/config/jellyfin:/config
Volume=/home/luke/data/media:/data/media
PublishPort=8096:8096
Network=media-stack.network
NetworkAlias=jellyfin

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=media-stack.target

[Quadlet]
DefaultDependencies=false
