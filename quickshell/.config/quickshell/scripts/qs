#!/usr/bin/env sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
build_import_path="$root/plugins/pinentry/build/qml"
installed_import_path="${XDG_DATA_HOME:-"$HOME/.local/share"}/qml"

append_import_path() {
    if [ -n "${1:-}" ]; then
        printf '%s:%s' "$module_import_paths" "$1"
    else
        printf '%s' "$module_import_paths"
    fi
}

# The pinentry module is optional: services/Pinentry.qml already degrades to
# "prompts disabled" when the module is absent, so a missing module must never
# stop the shell from starting. Probe for the real qmldir rather than the
# parent directory, so a half-finished build cannot shadow an installed module.
if [ -f "$build_import_path/Luke/Quickshell/Pinentry/qmldir" ]; then
    module_import_paths="$build_import_path:$installed_import_path"
else
    module_import_paths="$installed_import_path"
    if [ ! -f "$installed_import_path/Luke/Quickshell/Pinentry/qmldir" ]; then
        printf 'Pinentry QML module not found; GPG prompts will be disabled. Run: %s\n' \
            "$root/scripts/build-pinentry-plugin" >&2
    fi
fi

QML2_IMPORT_PATH=$(append_import_path "${QML2_IMPORT_PATH:-}")
QML_IMPORT_PATH=$(append_import_path "${QML_IMPORT_PATH:-}")
export QML2_IMPORT_PATH QML_IMPORT_PATH

quickshell_bin=${QUICKSHELL_BIN:-"$HOME/.local/bin/quickshell"}
if [ ! -x "$quickshell_bin" ]; then
    quickshell_bin=$(command -v quickshell || true)
fi

if [ -z "$quickshell_bin" ]; then
    echo "quickshell not found; set QUICKSHELL_BIN or put it on PATH" >&2
    exit 127
fi

exec "$quickshell_bin" "$@"
