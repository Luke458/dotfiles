#!/bin/sh
set -eu

# Open the selected image as the starting point of an imv directory album.
# imv loops the directory by default, preserving rotdir's previous wraparound
# navigation without constructing a newline-delimited filename list.
if [ "$#" -ne 1 ]; then
    printf 'usage: rotdir IMAGE\n' >&2
    exit 2
fi

if [ ! -f "$1" ]; then
    printf 'rotdir: not a file: %s\n' "$1" >&2
    exit 1
fi

exec /usr/bin/imv-dir "$1"
