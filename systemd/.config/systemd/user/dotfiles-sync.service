[Unit]
Description=Commit and push tracked dotfile changes
ConditionPathIsDirectory=%h/dotfiles/.git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=%h/.local/bin/dotfiles-sync
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
