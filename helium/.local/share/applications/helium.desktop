[Desktop Entry]
Version=1.0
Name=Helium Browser
GenericName=Web Browser
Comment=Access the Internet
Exec=env LIBVA_DRIVER_NAME=radeonsi helium-browser --skia-graphite-dawn-backend=vulkan --use-angle=vulkan --use-gl=angle --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks,AcceleratedVideoDecodeLinuxZeroCopyGL,Vulkan,DefaultANGLEVulkan,VulkanFromANGLE,SkiaGraphite %U
StartupNotify=true
StartupWMClass=helium
Terminal=false
Icon=helium-browser
Type=Application
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/unknown;x-scheme-handler/about;x-scheme-handler/web+wootwoot;application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=env LIBVA_DRIVER_NAME=radeonsi helium-browser --skia-graphite-dawn-backend=vulkan --use-angle=vulkan --use-gl=angle --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks,AcceleratedVideoDecodeLinuxZeroCopyGL,Vulkan,DefaultANGLEVulkan,VulkanFromANGLE,SkiaGraphite

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=env LIBVA_DRIVER_NAME=radeonsi helium-browser --skia-graphite-dawn-backend=vulkan --use-angle=vulkan --use-gl=angle --incognito --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks,AcceleratedVideoDecodeLinuxZeroCopyGL,Vulkan,DefaultANGLEVulkan,VulkanFromANGLE,SkiaGraphite
