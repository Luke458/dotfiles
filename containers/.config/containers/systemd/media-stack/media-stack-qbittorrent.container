[Unit]
Description=qBittorrent download client
PartOf=media-stack.target

[Container]
Image=lscr.io/linuxserver/qbittorrent:latest
ContainerName=qbittorrent
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=UMASK=002
Environment=TZ=Etc/UTC
Environment=WEBUI_PORT=8080
Volume=/home/luke/media-stack/config/qbittorrent:/config
Volume=/home/luke/data/torrents:/data/torrents
PublishPort=127.0.0.1:8080:8080
Network=media-stack.network
NetworkAlias=qbittorrent

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=media-stack.target

[Quadlet]
DefaultDependencies=false
