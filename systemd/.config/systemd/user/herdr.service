[Unit]
Description=Herdr agent workspace server

[Service]
Type=simple
ExecStart=%h/.local/share/mise/installs/herdr/latest/herdr server
WorkingDirectory=%h
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.local/share/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/opt/rocm/bin"
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
