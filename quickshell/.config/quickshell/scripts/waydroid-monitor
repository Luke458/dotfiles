#!/usr/bin/env python3
"""Emit a JSON snapshot of Waydroid and its generated desktop applications."""

from __future__ import annotations

import configparser
import json
import os
import shutil
import subprocess
import time
from pathlib import Path
from typing import Any


def run(command: list[str]) -> tuple[str, str, int]:
    try:
        completed = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
        )
        return completed.stdout, completed.stderr.strip(), completed.returncode
    except subprocess.TimeoutExpired:
        return "", f"Timed out running {command[0]}", 124
    except OSError as error:
        return "", str(error), 127


def key_values(text: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in text.splitlines():
        key, separator, value = line.partition(":")
        if separator:
            values[key.strip()] = value.strip()
    return values


def systemd_state() -> tuple[dict[str, str], str]:
    stdout, stderr, code = run(
        [
            "systemctl",
            "show",
            "waydroid-container.service",
            "--property=LoadState,ActiveState,SubState",
            "--no-pager",
        ]
    )
    values: dict[str, str] = {}
    for line in stdout.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value
    if code != 0:
        return values, stderr or "Unable to inspect waydroid-container.service"
    return values, ""


def desktop_apps() -> list[dict[str, Any]]:
    applications_dir = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "applications"
    apps: list[dict[str, Any]] = []
    for desktop_path in sorted(applications_dir.glob("waydroid.*.desktop")):
        package_name = desktop_path.name.removeprefix("waydroid.").removesuffix(".desktop")
        if not package_name:
            continue

        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.optionxform = str
        try:
            parser.read(desktop_path, encoding="utf-8")
            entry = parser["Desktop Entry"]
        except (configparser.Error, KeyError, OSError):
            continue

        name = entry.get("Name", package_name).strip() or package_name
        icon = entry.get("Icon", "").strip()
        icon_path = Path(icon).expanduser() if icon else None
        apps.append(
            {
                "name": name,
                "packageName": package_name,
                "icon": icon_path.as_uri() if icon_path and icon_path.is_absolute() and icon_path.exists() else "",
                "hidden": entry.getboolean("NoDisplay", fallback=False),
            }
        )

    apps.sort(key=lambda app: (app["hidden"], app["name"].casefold(), app["packageName"]))
    return apps


def snapshot() -> dict[str, Any]:
    available = shutil.which("waydroid") is not None
    errors: list[str] = []
    status: dict[str, str] = {}
    service, service_error = systemd_state() if available else ({}, "")
    if service_error:
        errors.append(service_error)
    service_state = service.get("ActiveState", "unknown").lower()

    # Querying `waydroid status` contacts id.waydro.Container. Its system D-Bus
    # activation file starts waydroid-container.service, so never run it while
    # the user has intentionally stopped the service.
    if available and service_state == "active":
        stdout, stderr, code = run(["waydroid", "status"])
        status = key_values(stdout)
        if code != 0:
            errors.append(stderr or "Unable to read Waydroid status")
    elif not available:
        errors.append("Waydroid is not installed")

    session_state = status.get("Session", "STOPPED" if service_state != "active" else "UNKNOWN").upper()
    container_state = status.get("Container", "STOPPED").upper() or "STOPPED"
    service_active = service_state == "active"

    apps = desktop_apps()
    return {
        "available": available,
        "sessionState": session_state,
        "sessionRunning": session_state == "RUNNING",
        "containerState": container_state,
        "containerServiceState": service_state,
        "containerServiceSubState": service.get("SubState", "unknown").lower(),
        "serviceActive": service_active,
        "containerRunning": container_state in ("RUNNING", "FROZEN"),
        "vendorType": status.get("Vendor type", ""),
        "ipAddress": status.get("IP address", ""),
        "sessionUser": status.get("Session user", ""),
        "waylandDisplay": status.get("Wayland display", ""),
        "apps": apps,
        "appCount": len(apps),
        "updatedAt": int(time.time() * 1000),
        "error": "; ".join(dict.fromkeys(error for error in errors if error)),
    }


def main() -> None:
    print(json.dumps(snapshot(), separators=(",", ":")), flush=True)


if __name__ == "__main__":
    main()
