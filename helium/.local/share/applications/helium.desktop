[Desktop Entry]
Version=1.0
Name=Helium Browser
GenericName=Web Browser
Comment=Access the Internet
Exec=helium-browser --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks --audio-channels=8 --try-supported-channel-layouts %U
StartupNotify=true
StartupWMClass=helium
Terminal=false
Icon=helium-browser
Type=Application
Categories=Network;WebBrowser;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=helium-browser --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks --audio-channels=8 --try-supported-channel-layouts

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=helium-browser --incognito --proxy-server=http://127.0.0.1:2080 --ozone-platform=wayland --enable-gpu-rasterization --enable-features=WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks --audio-channels=8 --try-supported-channel-layouts
MimeType=x-scheme-handler/web+wootwoot;application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;
