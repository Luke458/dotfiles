{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": "  ➜  "
  },
  "modules": [
    "break",
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "Host ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "Ker  ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Up   ",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "Pkg  ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "display",
      "key": "Disp ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "DE   ",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "Theme",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "Term ",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU  ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "GPU  ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "RAM  ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "Disk ",
      "keyColor": "red"
    },
    {
      "type": "localip",
      "key": "LAN  ",
      "keyColor": "magenta",
      "compact": true
    },
    "break",
    "colors"
  ]
}
